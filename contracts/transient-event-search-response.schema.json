{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Action": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "open_source",
            "open_map"
          ],
          "title": "Code",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "code",
        "url"
      ],
      "title": "Action",
      "type": "object"
    },
    "ActivityCode": {
      "enum": [
        "walk",
        "museum",
        "food",
        "culture",
        "sport",
        "shopping",
        "entertainment",
        "other"
      ],
      "title": "ActivityCode",
      "type": "string"
    },
    "ClarificationReason": {
      "enum": [
        "conflicting_constraints",
        "unparsed_constraint"
      ],
      "title": "ClarificationReason",
      "type": "string"
    },
    "ConstraintClarification": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "$ref": "#/$defs/ExplicitField"
        },
        "reason": {
          "$ref": "#/$defs/ClarificationReason"
        }
      },
      "required": [
        "field",
        "reason"
      ],
      "title": "ConstraintClarification",
      "type": "object"
    },
    "Coordinates": {
      "additionalProperties": false,
      "properties": {
        "latitude": {
          "maximum": 90,
          "minimum": -90,
          "title": "Latitude",
          "type": "number"
        },
        "longitude": {
          "maximum": 180,
          "minimum": -180,
          "title": "Longitude",
          "type": "number"
        }
      },
      "required": [
        "latitude",
        "longitude"
      ],
      "title": "Coordinates",
      "type": "object"
    },
    "ExplicitField": {
      "enum": [
        "origin",
        "available_minutes",
        "return_to_start",
        "budget_kzt_per_person",
        "indoor_only",
        "date_time"
      ],
      "title": "ExplicitField",
      "type": "string"
    },
    "FieldCheck": {
      "additionalProperties": false,
      "description": "Trusted caller's source check, never accepted from model extraction JSON.",
      "properties": {
        "session_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "field": {
          "enum": [
            "city",
            "venue_name",
            "venue_address",
            "starts_at",
            "ends_at",
            "price_from",
            "currency",
            "price_conditions",
            "status"
          ],
          "title": "Field",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Value"
        },
        "source_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "checked_at": {
          "format": "date-time",
          "title": "Checked At",
          "type": "string"
        },
        "method": {
          "enum": [
            "manual_source",
            "licensed_feed"
          ],
          "title": "Method",
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "field",
        "value",
        "source_url",
        "checked_at",
        "method"
      ],
      "title": "FieldCheck",
      "type": "object"
    },
    "FitStatus": {
      "enum": [
        "fits",
        "does_not_fit",
        "unknown"
      ],
      "title": "FitStatus",
      "type": "string"
    },
    "MissingField": {
      "enum": [
        "origin",
        "available_minutes",
        "date_time",
        "location",
        "price_kzt_per_person",
        "indoor",
        "opening_hours",
        "visit_minutes_estimate",
        "travel_minutes_estimate",
        "weather",
        "session_time",
        "child_suitability",
        "age_restrictions",
        "power_outlets",
        "public_access"
      ],
      "title": "MissingField",
      "type": "string"
    },
    "NormalizedEvent": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "title": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "source_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "source_fetched_at": {
          "format": "date-time",
          "title": "Source Fetched At",
          "type": "string"
        },
        "city": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "City"
        },
        "venue_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Venue Name"
        },
        "venue_address": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Venue Address"
        },
        "venue": {
          "$ref": "#/$defs/VenueMatch"
        },
        "status": {
          "enum": [
            "listing",
            "discovered"
          ],
          "title": "Status",
          "type": "string"
        },
        "schedule_hints": {
          "items": {
            "type": "string"
          },
          "title": "Schedule Hints",
          "type": "array"
        },
        "missing_fields": {
          "items": {
            "type": "string"
          },
          "title": "Missing Fields",
          "type": "array"
        },
        "sessions": {
          "items": {
            "$ref": "#/$defs/NormalizedSession"
          },
          "title": "Sessions",
          "type": "array"
        }
      },
      "required": [
        "event_id",
        "title",
        "source_url",
        "source_fetched_at",
        "city",
        "venue_name",
        "venue_address",
        "venue",
        "status",
        "schedule_hints",
        "missing_fields",
        "sessions"
      ],
      "title": "NormalizedEvent",
      "type": "object"
    },
    "NormalizedSession": {
      "additionalProperties": false,
      "properties": {
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "source_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "source_fetched_at": {
          "format": "date-time",
          "title": "Source Fetched At",
          "type": "string"
        },
        "city": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "City"
        },
        "venue_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Venue Name"
        },
        "venue_address": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Venue Address"
        },
        "venue": {
          "$ref": "#/$defs/VenueMatch"
        },
        "starts_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Starts At"
        },
        "ends_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ends At"
        },
        "price_from": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Price From"
        },
        "currency": {
          "anyOf": [
            {
              "const": "KZT",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Currency"
        },
        "price_conditions": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Price Conditions"
        },
        "price_kind": {
          "enum": [
            "starting",
            "regular",
            "promotion",
            "unknown"
          ],
          "title": "Price Kind",
          "type": "string"
        },
        "status": {
          "enum": [
            "scheduled",
            "cancelled",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "verification_status": {
          "default": "discovered",
          "enum": [
            "discovered",
            "verified"
          ],
          "title": "Verification Status",
          "type": "string"
        },
        "verified_fields": {
          "items": {
            "$ref": "#/$defs/FieldCheck"
          },
          "title": "Verified Fields",
          "type": "array"
        },
        "ticket_availability": {
          "const": "unknown",
          "default": "unknown",
          "title": "Ticket Availability",
          "type": "string"
        },
        "missing_fields": {
          "items": {
            "type": "string"
          },
          "title": "Missing Fields",
          "type": "array"
        },
        "recommendation_candidate": {
          "title": "Recommendation Candidate",
          "type": "boolean"
        },
        "exclusion_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Exclusion Reasons",
          "type": "array"
        }
      },
      "required": [
        "session_id",
        "event_id",
        "source_url",
        "source_fetched_at",
        "city",
        "venue_name",
        "venue_address",
        "venue",
        "starts_at",
        "ends_at",
        "price_from",
        "currency",
        "price_conditions",
        "price_kind",
        "status",
        "missing_fields",
        "recommendation_candidate",
        "exclusion_reasons"
      ],
      "title": "NormalizedSession",
      "type": "object"
    },
    "ReasonCode": {
      "enum": [
        "query_match",
        "nearby",
        "within_time",
        "within_budget",
        "indoor_match",
        "time_unknown",
        "budget_unknown",
        "hours_unknown",
        "route_unknown",
        "visit_duration_estimate",
        "weather_unknown",
        "schedule_unknown",
        "family_playground_match",
        "power_outlets_match"
      ],
      "title": "ReasonCode",
      "type": "string"
    },
    "ResponseStatus": {
      "enum": [
        "ok",
        "partial",
        "unknown",
        "unavailable",
        "no_match"
      ],
      "title": "ResponseStatus",
      "type": "string"
    },
    "RouteStatus": {
      "enum": [
        "known",
        "estimated",
        "unknown",
        "unavailable",
        "not_requested"
      ],
      "title": "RouteStatus",
      "type": "string"
    },
    "TransientEvent": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "city": {
          "anyOf": [
            {
              "maxLength": 150,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "City"
        },
        "venue_name": {
          "anyOf": [
            {
              "maxLength": 300,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Venue Name"
        },
        "venue_address": {
          "anyOf": [
            {
              "maxLength": 300,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Venue Address"
        },
        "source_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "source_id"
      ],
      "title": "TransientEvent",
      "type": "object"
    },
    "TransientEventCard": {
      "additionalProperties": false,
      "properties": {
        "event": {
          "$ref": "#/$defs/TransientEvent"
        },
        "session": {
          "$ref": "#/$defs/NormalizedSession"
        },
        "source_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "reason_codes": {
          "items": {
            "$ref": "#/$defs/ReasonCode"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Reason Codes",
          "type": "array"
        },
        "activity_code": {
          "$ref": "#/$defs/ActivityCode",
          "default": "other"
        },
        "visit_minutes_estimate": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 10080,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Visit Minutes Estimate"
        },
        "route_status": {
          "$ref": "#/$defs/RouteStatus"
        },
        "travel_minutes_estimate": {
          "anyOf": [
            {
              "maximum": 10080,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Travel Minutes Estimate"
        },
        "fit_status": {
          "$ref": "#/$defs/FitStatus"
        },
        "missing_fields": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "title": "Missing Fields",
          "type": "array"
        },
        "explanation": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "generated_locale": {
          "enum": [
            "kk",
            "ru",
            "en"
          ],
          "title": "Generated Locale",
          "type": "string"
        },
        "action": {
          "$ref": "#/$defs/Action"
        }
      },
      "required": [
        "event",
        "session",
        "source_ids",
        "reason_codes",
        "route_status",
        "travel_minutes_estimate",
        "fit_status",
        "missing_fields",
        "explanation",
        "generated_locale",
        "action"
      ],
      "title": "TransientEventCard",
      "type": "object"
    },
    "TransientEventSource": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "source_updated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Updated At"
        },
        "storage_allowed": {
          "const": false,
          "default": false,
          "title": "Storage Allowed",
          "type": "boolean"
        },
        "indexing_allowed": {
          "const": false,
          "default": false,
          "title": "Indexing Allowed",
          "type": "boolean"
        }
      },
      "required": [
        "source_id",
        "url",
        "retrieved_at"
      ],
      "title": "TransientEventSource",
      "type": "object"
    },
    "VenueMatch": {
      "additionalProperties": false,
      "properties": {
        "poi_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Poi Id"
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/Coordinates"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "basis": {
          "default": "unknown",
          "enum": [
            "name_address_astana_permitted_poi",
            "unknown",
            "ambiguous"
          ],
          "title": "Basis",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "source_urls": {
          "items": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "type": "string"
          },
          "title": "Source Urls",
          "type": "array"
        },
        "coordinate_accuracy": {
          "const": "unknown",
          "default": "unknown",
          "title": "Coordinate Accuracy",
          "type": "string"
        },
        "geography_basis": {
          "default": "unknown",
          "enum": [
            "central_astana_bbox",
            "unknown"
          ],
          "title": "Geography Basis",
          "type": "string"
        }
      },
      "title": "VenueMatch",
      "type": "object"
    },
    "Warning": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/WarningCode"
        },
        "message": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/MissingField"
          },
          "title": "Fields",
          "type": "array"
        },
        "clarifications": {
          "items": {
            "$ref": "#/$defs/ConstraintClarification"
          },
          "maxItems": 6,
          "title": "Clarifications",
          "type": "array"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "Warning",
      "type": "object"
    },
    "WarningCode": {
      "enum": [
        "missing_input",
        "data_unknown",
        "provider_unavailable",
        "route_unavailable",
        "weather_unavailable",
        "source_stale",
        "test_data"
      ],
      "title": "WarningCode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "contract_version": {
      "const": "1.3.0",
      "default": "1.3.0",
      "title": "Contract Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ResponseStatus"
    },
    "provider_status": {
      "enum": [
        "partial",
        "unknown",
        "unavailable"
      ],
      "title": "Provider Status",
      "type": "string"
    },
    "provider_code": {
      "anyOf": [
        {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z0-9_]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Code"
    },
    "live_web_search": {
      "enum": [
        "not_run",
        "passed",
        "failed"
      ],
      "title": "Live Web Search",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/TransientEventCard"
      },
      "maxItems": 3,
      "title": "Items",
      "type": "array"
    },
    "listings": {
      "items": {
        "$ref": "#/$defs/NormalizedEvent"
      },
      "maxItems": 10,
      "title": "Listings",
      "type": "array"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/TransientEventSource"
      },
      "maxItems": 100,
      "title": "Sources",
      "type": "array"
    },
    "warnings": {
      "items": {
        "$ref": "#/$defs/Warning"
      },
      "maxItems": 100,
      "title": "Warnings",
      "type": "array"
    },
    "excluded_sessions": {
      "default": 0,
      "minimum": 0,
      "title": "Excluded Sessions",
      "type": "integer"
    },
    "rejected_events": {
      "default": 0,
      "minimum": 0,
      "title": "Rejected Events",
      "type": "integer"
    }
  },
  "required": [
    "request_id",
    "status",
    "provider_status",
    "live_web_search",
    "items",
    "listings",
    "sources",
    "warnings"
  ],
  "title": "TransientEventSearchResponse",
  "type": "object"
}
