{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ClarificationReason": {
      "enum": [
        "conflicting_constraints",
        "unparsed_constraint"
      ],
      "title": "ClarificationReason",
      "type": "string"
    },
    "ConstraintClarification": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "$ref": "#/$defs/ExplicitField"
        },
        "reason": {
          "$ref": "#/$defs/ClarificationReason"
        }
      },
      "required": [
        "field",
        "reason"
      ],
      "title": "ConstraintClarification",
      "type": "object"
    },
    "ExplicitField": {
      "enum": [
        "origin",
        "available_minutes",
        "return_to_start",
        "budget_kzt_per_person",
        "indoor_only",
        "date_time"
      ],
      "title": "ExplicitField",
      "type": "string"
    },
    "MissingField": {
      "enum": [
        "origin",
        "available_minutes",
        "date_time",
        "location",
        "price_kzt_per_person",
        "indoor",
        "opening_hours",
        "visit_minutes_estimate",
        "travel_minutes_estimate",
        "weather",
        "session_time",
        "child_suitability",
        "age_restrictions",
        "power_outlets",
        "public_access"
      ],
      "title": "MissingField",
      "type": "string"
    },
    "RouteLeg": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "known",
            "unknown",
            "unavailable",
            "not_requested"
          ],
          "title": "Status",
          "type": "string"
        },
        "distance_meters": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distance Meters"
        },
        "duration_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Seconds"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/RouteProvenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "invalid_settings",
                "disabled",
                "key_missing",
                "rights_unconfirmed",
                "access_denied",
                "timeout",
                "rate_limited",
                "http_error",
                "network_error",
                "provider_fail",
                "route_not_found",
                "invalid_response",
                "missing_origin",
                "not_requested"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "status"
      ],
      "title": "RouteLeg",
      "type": "object"
    },
    "RouteProvenance": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "const": "twogis",
          "default": "twogis",
          "title": "Provider",
          "type": "string"
        },
        "endpoint": {
          "const": "https://routing.api.2gis.com/routing/7.0.0/global",
          "default": "https://routing.api.2gis.com/routing/7.0.0/global",
          "title": "Endpoint",
          "type": "string"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "transport": {
          "const": "walking",
          "default": "walking",
          "title": "Transport",
          "type": "string"
        },
        "provider_locale": {
          "enum": [
            "ru",
            "en"
          ],
          "title": "Provider Locale",
          "type": "string"
        },
        "storage_allowed": {
          "const": false,
          "default": false,
          "title": "Storage Allowed",
          "type": "boolean"
        },
        "indexing_allowed": {
          "const": false,
          "default": false,
          "title": "Indexing Allowed",
          "type": "boolean"
        },
        "ai_allowed": {
          "const": false,
          "default": false,
          "title": "Ai Allowed",
          "type": "boolean"
        }
      },
      "required": [
        "retrieved_at",
        "provider_locale"
      ],
      "title": "RouteProvenance",
      "type": "object"
    },
    "Warning": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/WarningCode"
        },
        "message": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/MissingField"
          },
          "title": "Fields",
          "type": "array"
        },
        "clarifications": {
          "items": {
            "$ref": "#/$defs/ConstraintClarification"
          },
          "maxItems": 6,
          "title": "Clarifications",
          "type": "array"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "Warning",
      "type": "object"
    },
    "WarningCode": {
      "enum": [
        "missing_input",
        "data_unknown",
        "provider_unavailable",
        "route_unavailable",
        "weather_unavailable",
        "source_stale",
        "test_data"
      ],
      "title": "WarningCode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "status": {
      "default": "unavailable",
      "enum": [
        "known",
        "unknown",
        "unavailable"
      ],
      "title": "Status",
      "type": "string"
    },
    "travel_minutes_estimate": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Travel Minutes Estimate"
    },
    "outbound": {
      "$ref": "#/$defs/RouteLeg"
    },
    "return_route": {
      "$ref": "#/$defs/RouteLeg"
    },
    "destination_precision": {
      "const": "approximate",
      "default": "approximate",
      "title": "Destination Precision",
      "type": "string"
    },
    "warnings": {
      "items": {
        "$ref": "#/$defs/Warning"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "request_id",
    "warnings"
  ],
  "title": "RouteResponse",
  "type": "object"
}
