# Empty values intentionally disable external preflight checks.
DATABASE_URL=
DATABASE_POOL_SIZE=3
APP_ENV=production
DEV_FIXTURE_MODE=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=1536
TWOGIS_API_KEY=
TWOGIS_ENABLED=false
# Enable only with confirmed endpoint access and reviewed runtime use rights.
TWOGIS_PLACES_ALLOWED=false
TWOGIS_ROUTING_ALLOWED=false
TWOGIS_DISCOVERY_ALLOWED=false
# Regions API requires its own entitled server key, never a browser map key.
TWOGIS_REGION_API_KEY=
# Reference to the reviewed project-specific agreement/decision, not an API key.
TWOGIS_RIGHTS_BASIS=
APP_TIMEZONE=Asia/Almaty
DEFAULT_LOCALE=kk
